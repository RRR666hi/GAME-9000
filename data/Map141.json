{"id":1,"name":"サブ-唯叶④２０","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":20,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"!EventIcon","direction":2,"pattern":1,"characterIndex":2},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"D","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":233,"variableValid":true,"variableValue":20},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":2},"list":[{"code":121,"indent":0,"parameters":[15,15,0]},{"code":205,"indent":0,"parameters":[2,{"list":[{"code":41,"parameters":["charaMob4",3],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":41,"parameters":["charaMob4",3],"indent":null}]},{"code":203,"indent":0,"parameters":[2,0,11,3,6]},{"code":230,"indent":0,"parameters":[90]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　「財団」の本拠地を調べる必要がある。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　このままだと、より活動を激しく、過激になっている財団とのいたちごっこを続"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　けるだけになってしまう。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　そうしている間にも、たくさんの人がカゲになっちゃう。カゲは自分自身を傷つ"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　けるし、一般人が襲われたらケガで済まない場合もある。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　一刻も早く対処しなきゃいけない……から、色んなところで情報を集めるように"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　していた。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　そこで、とある掲示板の書き込みに目がいった。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　インカレサークル「Gang Bang」と呼ばれる集団が、若い女の子を中心"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　に人を集めていて、被害に合ってる人が多い。主な活動場所はこの街で、特に冥"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　々通りの居酒屋などで暗躍している……というものだった。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　「財団」は、少なくともこの街のどこかで活動しているきらいがある。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　だから、このインカレサークル？　というものはよくわからないけど、これがも"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　し財団の隠れ蓑になっているなら、調べてみないといけない……！　と、わたし"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　は決心した。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　(年齢をちょっとごまかして)代表の人にコンタクトを送ってみると、すぐに返"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　信が帰ってきた。なんでも今日、新入生の歓迎会をするみたいだった。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\F[yuDe22]\\AA[F]\\V[121](これはチャンス……！)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　財団とは何度も相対してるけど、それはリリスちゃん相手ばかりだし、魔法少女"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　の恰好をしなければより一層バレないはず。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ここはセンニューソーサをして、店長に一目置かれるチャンス……！"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　……とか、そう考えていた。"]},{"code":222,"indent":0,"parameters":[]},{"code":357,"indent":0,"parameters":["TemplateEvent","CALL_TEMPLATE_EVENT","テンプレートイベント呼び出し",{"pageIndex":"1","eventId":"SUB唯叶④"}]},{"code":657,"indent":0,"parameters":["ページ番号 = 1"]},{"code":657,"indent":0,"parameters":["イベントID(もしくは名称) = SUB唯叶④"]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　……やってしまった。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　派手に酔い、そしてそのまま……初めて会った人に、お持ち帰り……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\F[yuDe25]\\AA[F]\\V[121](こんなの、エッチな人みたいだよお……)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　オトナな恋愛には憧れるけど、こういうのはちょっと違う気がする……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　お兄さんは悪い人だけど、面倒はちゃんと見てくれた人だった。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　脱水とかを気にしてくれて、意識がちゃんとするまで一緒にいてくれたし、介抱"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　してくれた……けど、よくないものはよくない。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　こんなのやっちゃダメなんですからね！　と怒ったら、「でも気持ちよさそうだ"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ったよ」と言われて、何も言い返せなかった。……そこは否定できないから。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\F[yuDe19]\\AA[F]\\V[121]「はぁ、結局財団とは関係ないやつだったかぁ……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　その後、色々お兄さんに聞いてみたけど、全くの無関係……このインカレサーク"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ルは、エッチなことに興味のある人が集まって、その日限りの身体の関係を持つ"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　場所……らしい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　気持ちよければそれでいい、みたいなモットーらしいから、魔法少女やカゲとは"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　何の関係もない組織だった。……それはそれとして、騙される女の子もいるのは"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　事実な気がしたので、お兄さんの所属している大学にあとで通報することにした。"]},{"code":122,"indent":0,"parameters":[233,233,1,0,10]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":38,"indent":null},{"code":40,"indent":null},{"code":29,"parameters":[4],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":38,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":40,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":29,"parameters":[4],"indent":null}]},{"code":121,"indent":0,"parameters":[15,15,1]},{"code":201,"indent":0,"parameters":[0,4,11,7,2,0]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":233,"variableValid":true,"variableValue":30},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":0,"y":1},
