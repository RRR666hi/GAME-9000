":0,"parameters":[{"code":14,"parameters":[0,0],"indent":null}]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi4]\\F[yuDe2]\\AA[FFFF]\\V[130]「ん……？　ああ、いや！　そうじゃなくてさ、なんというかさ……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi4]\\F[yuDe17]\\AA[F]\\V[121]「……えへへ、せんぱい、必死に手、ブンブンってして。かわいい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi4]\\F[yuDe4]\\AA[F]\\V[121]「さ！　いっぱい遊んじゃいましょ、せんぱい！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe4]\\AA[FFFF]\\V[130]「そうだな、全制覇するか！」"]},{"code":201,"indent":0,"parameters":[0,143,3,11,4,0]},{"code":203,"indent":0,"parameters":[3,0,2,11,6]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi7]\\F[yuDe4]\\AA[FFFF]\\V[130]「お、この味うまい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi7]\\F[yuDe1]\\AA[F]\\V[121]「チェダーチーズ味でしたっけ？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe1]\\AA[FFFF]\\V[130]「そうそう。はい唯叶ちゃん、あーん」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe3]\\AA[F]\\V[121]「わ……あ、あーん……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi7]\\F[yuDe3]\\AA[FFFF]\\V[130]「うまくね？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi7]\\F[yuDe11]\\AA[F]\\V[121]「……おいひいれす」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi7]\\F[yuDe17]\\AA[F]\\V[121]「んぐっ……せんぱいも、わたしのやつ食べてみてください。抹茶味なんですって」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi6]\\F[yuDe17]\\AA[FFFF]\\V[130]「ポップコーンで抹茶？　あんまり合う気しないけどなあ」"]}