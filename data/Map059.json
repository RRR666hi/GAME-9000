rs":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe16]\\AA[FFFF]\\V[126]「今回行くのは市民プール……行った事ある？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe16]\\F[yuDe1]\\AA[F]\\V[121]「友達となんかいか。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe15]\\F[yuDe1]\\AA[FFFF]\\V[126]「あそこでカゲが湧いた。被害が広がる前に浄化しなきゃいけない。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe12]\\F[yuDe1]\\AA[FFFF]\\V[126]「正気に戻すことを正しくは浄化、っていうんだって。"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　こういう言い換えみたいなの他にもあるから、"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　気になったらアジトにある資料を確認して。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe12]\\F[yuDe5]\\AA[F]\\V[121]「わかりました！……それで、わたしは何をすればいいんですか？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe4]\\F[yuDe5]\\AA[FFFF]\\V[126]「んー、それを説明する前に、"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　あたしの魔法の力について話しておくね。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe2]\\F[yuDe5]\\AA[FFFF]\\V[126]「あたしの魔法は『鬼火』。お墓でうようよしてる光とか"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　火の玉……みたいなのあるじゃん。イメージはあれ。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe2]\\F[yuDe5]\\AA[FFFF]\\V[126]「カゲは性質上光に弱いの。太陽光で焼ける……"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　みたいなのはないけど、暗いとこを好む傾向にある。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe15]\\F[yuDe5]\\AA[FFFF]\\V[126]「鬼火は強烈な光球をブチ当てるから、"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　カゲには効果バツグン。ただ――」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe15]\\F[yuDe5]\\AA[FFFF]\\V[126]「あたしは真っ暗な場所でしか魔法の力を使えない。"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　明所では変身も勝手に解けるし、"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　唯叶みたいに魔法防御を貼ることすらできない。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe15]\\F[yuDe8]\\AA[F]\\V[121]「魔法って変身してるとき以外も使えるんですか？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe15]\\F[yuDe8]\\AA[FFFF]\\V[126]「変身ってようは衣装を変える魔法を使ってるだけだから。"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　戦って普段着汚れたら嫌じゃん？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe15]\\F[yuDe9]\\AA[F]\\V[121]「な、なるほど」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe3]\\F[yuDe9]\\AA[FFFF]\\V[126]「つまり明るい場所ではなんにもできないんだ。ここまではオーケー？」"]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe3]\\F[yuDe5]\\AA[F]\\V[121]「真っ暗って、具体的にはどんな感じですか？夜なら大丈夫ですよね？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe2]\\F[yuDe5]\\AA[FFFF]\\V[126]「んー大丈夫。それ以外だと窓のない部屋の中……"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　とか、限定されてくる。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe2]\\F[yuDe7]\\AA[F]\\V[121]「え、じゃあどうするんですか？市民プールって……"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　大きい窓ありますし、屋内とはいえめちゃ明るい場所ですよね？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[teDe1]\\F[yuDe7]\\AA[FFFF]\\V[126]「……着いた。あとは現地で話そっか」"]},{"code":221,"indent":0,"parameters":[]},{"code":122,"indent":0,"parameters":[202,202,1,0,1]},{"code":230,"indent":0,"parameters":[20]},{"code":201,"indent":0,"parameters":[0,34,9,18,8,2]},{"code":230,"indent":0,"parameters":[20]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":0,"y":0}
