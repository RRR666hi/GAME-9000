{"id":2,"name":"サブ-唯叶④１０","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":20,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"!EventIcon","direction":2,"pattern":1,"characterIndex":2},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"D","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":233,"variableValid":true,"variableValue":10},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":2},"list":[{"code":121,"indent":0,"parameters":[15,15,0]},{"code":205,"indent":0,"parameters":[1,{"list":[{"code":41,"parameters":["charaMob4",3],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":41,"parameters":["charaMob4",3],"indent":null}]},{"code":203,"indent":0,"parameters":[1,0,9,2,2]},{"code":230,"indent":0,"parameters":[120]},{"code":243,"indent":0,"parameters":[]},{"code":242,"indent":0,"parameters":[2]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\AA[FFFF]　　　お兄さん：　「唯叶ちゃん、飲んでるぅ～！？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[F]\\V[121]「えっ、あ、はい……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[FFFF]　　　お兄さん：　「あれ、まだ余裕そうってカンジ？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[F]\\V[121]「そ、そんなことないです……ただ、お酒はあんまり飲まないので……あはは……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[FFFF]　　　お兄さん：　「あ、あんまし得意じゃないってやつね。そんな唯叶ちゃんには……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe8]\\AA[F]\\V[121]「……これは？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe8]\\AA[FFFF]　　　お兄さん：　「キレイっしょ？　これさ、ホワイトルシアンってやつでさー……コーヒーと生"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　クリームのやつなの。飲みやすいし優しい甘さでおいしいよ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　……たしかに、コーヒーフロートみたいで見た目はかわいい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　全く飲まないっていうのも怪しまれそうだし……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　意を決して一口、飲んでみる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe4]\\AA[F]\\V[121]「えっ……！？　おいしいかも……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe4]\\AA[FFFF]　　　お兄さん：　「でしょ？　これならいけそう？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[F]\\V[121]「そ、そうですね」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[FFFF]　　　お兄さん：　「いいねぇ！　それ飲みながらさ、オレとちょっとお話しない？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[F]\\V[121]「あ、はい、ぜひ……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　緊張で喉が渇いていたのもあって、想像してたよりずっと美味しかったお酒を、"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ついつい飲んでしまう。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe2]\\AA[FFFF]　　　お兄さん：　「んでさ、この『現代社会論』ってのは結構楽単なのよ。出席あるんだけどカー"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ドリーダー回されるやつだからさ、何人かで当番すればオッケーってわけ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe15]\\AA[F]\\V[121]「は、はあ……そうなんですか……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe15]\\AA[FFFF]　　　お兄さん：　「だからその間に……って、唯叶ちゃん？　おーい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe14]\\AA[F]\\V[121]「は、はい……？　なんれすか……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　くらくらってして、目が回って。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ふらふら、ゆらゆら。頭が重い。まぶたが……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ダメなのに……情報、集めないと……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe14]\\AA[FFFF]　　　お兄さん：　「だいじょぶー？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[1]\\F[yuDe13]\\AA[FFFF]　　　お兄さん：　「ぁ……ぅ……」"]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　意識が暗闇に沈んでいくみたいで……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　どうして、こんなことになったんだっけ……。"]},{"code":122,"indent":0,"parameters":[233,233,1,0,10]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":38,"indent":null},{"code":40,"indent":null},{"code":29,"parameters":[4],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":38,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":40,"indent":null}]},{"code":5