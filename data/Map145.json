,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi10]\\F[yuDe8]\\AA[FFFF]\\V[130]「俺、俺はさ……確かにあのとき、唯叶ちゃんに誘われてエッチなこと、したけ"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　ど……でも」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi10]\\F[yuDe8]\\AA[FFFF]\\V[130]「でも、本当は、部活で君を見たときから、ずっと気になってたんだ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe8]\\AA[FFFF]\\V[130]「順番が逆になっちゃったけど……俺と、付き合ってくれないか……！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe27]\\AA[F]\\V[121]「ぁ…………」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　多分そうなんだろうな、って思ってた。それに、やっぱり……嬉しい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　そりゃあ、今わたしが今すぐ誰かとお付き合いするってなったら、せんぱいがいい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　だけど、だけど……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe8]\\AA[F]\\V[121]「……せんぱい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe4]\\AA[F]\\V[121]「うれしいです、わたし……そう、言ってもらえて」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe19]\\AA[F]\\V[121]「でも……ダメなんです。今は」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi6]\\F[yuDe19]\\AA[FFFF]\\V[130]「それは、やっぱり……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi6]\\F[yuDe22]\\AA[F]\\V[121]「はい。わたし──魔法少女なんです」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi6]\\F[yuDe22]\\AA[F]\\V[121]「魔法少女は、この前みたいなときに戦う使命があります」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi6]\\F[yuDe2]\\AA[F]\\V[121]「わたしは、魔法が使えないけど……それでも」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi6]\\F[yuDe21]\\AA[F]\\V[121]「もし、わたしに何かあったら……そのときに、大切なせんぱいに傷ついてほし"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　くありません」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\F[yuDe4]\\AA[F]\\V[121]「でも……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　わたしはせんぱいの頬に、そっと口づけする。"]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi6]\\F[yuDe4]\\AA[F]\\V[121]「嬉しかったです。とっても」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe4]\\AA[FFFF]\\V[130]「そ、っか……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　魔法少女になる前はあんなに憧れてた、かっこいい男の人とのお付き合い。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　でも今は、わたしにしかできないことをしたい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe8]\\AA[F]\\V[121]「だから……今は、お友達からで。それじゃ、ダメですか……？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe8]\\AA[FFFF]\\V[130]「ズルいな、唯叶ちゃんは。そんな顔で言われたら断れないよ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe2]\\AA[F]\\V[121]「えへへ……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　そろそろ観覧車が一周する。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　だけど、もう少しせんぱいと一緒にいたい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　それに……。"]},{"code":230,"indent":0,"parameters":[40]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\F[yuDe4]\\AA[F]\\V[121]「あの、もう一周してもいいですか？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　乗降口にいるスタッフさんに声をかけると、待ってる人いないんでいいですよ、"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　と言ってもらえた。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi8]\\F[yuDe4]\\AA[FFFF]\\V[130]「唯叶ちゃん？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi8]\\F[yuDe1]\\AA[F]\\V[121]「いいじゃないですか、あと一周くらい。それに……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi8]\\F[yuDe14]\\AA[F]\\V[121]「(今立ったら、バレちゃいますよ)」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe14]\\AA[FFFF]\\V[130]「そ、それは……！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　期待してくれてたんだなというか、わたしにドキドキしてくれたんだってのがわ"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　かって、うれしい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　わたしがせんぱいをドキドキさせてるんだ。他でもない、わたしが……。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　せんぱいの、ズボンの中身の部分が大きくなってるのがわかる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe14]\\AA[F]\\V[121]「あんまり激しくしちゃうと、バレちゃいますから……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe12]\\AA[F]\\V[121]「だから、今日はこっちで……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　せんぱいが、ゴクリとつばを飲み込む音がした。"]},{"code":357,"indent":0,"parameters":["TemplateEvent","CALL_TEMPLATE_EVENT","テンプレートイベント呼び出し",{"pageIndex":"1","eventId":"SUB唯叶③"}]},{"code":657,"indent":0,"parameters":["ページ番号 = 1"]},{"code":657,"indent":0,"parameters":["イベントID(もしくは名称) = SUB唯叶③"]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\AA[FFFF]\\V[130]「その……ありがとう、唯叶ちゃん」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe2]\\AA[F]\\V[121]「い、いえ……すみません、わたしも夢中になっちゃって……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　あわてて掃除をして、ふたりで一緒に暗くなっていく道を歩く。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　夜は比較的カゲが発生することが多い。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　だから夜は、自然と気が引き締まる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　それに、そろそろ駅に着いちゃう。せんぱいとは反対方向だから、もうお別れの"]},{"code":401,"indent":0,"parameters":["　　　　　　　　　時間が近付いていた。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　──最後にもうちょっとだけ、わがままでもいいかな。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["　　　　　　　　　せんぱいの手をにぎる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe1]\\AA[F]\\V[121]「わたし、がんばるので……」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi9]\\F[yuDe4]\\AA[F]\\V[121]「応援、してくれますか。せんぱい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe4]\\AA[FFFF]\\V[130]「……うん。待ってるよ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe22]\\AA[F]\\V[121]「……！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\FFFF[seSi1]\\F[yuDe4]\\AA[F]\\V[121]「はいっ！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"ind